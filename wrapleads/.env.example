# Copy this to `.env` and fill in your values. The .env file is gitignored.

# Postgres connection — defaults match docker-compose.yml
DATABASE_URL=postgresql://wrapleads:wrapleads@localhost:5432/wrapleads

# Server port
PORT=3001

# OPTIONAL: Apollo.io API key. If set here, the CRM doesn't need to send it
# with each request (more secure). If blank, the CRM Settings field is used.
APOLLO_API_KEY=

# OPTIONAL: Google Places API key — required only for ingest-google-places.js
GOOGLE_PLACES_API_KEY=

# No FMCSA API key needed — ingest-fmcsa.js uses the open data.transportation.gov API

# ── Auth (required for SaaS mode) ────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Trial length for new accounts (days). Default: 14
TRIAL_DAYS=14

# ── Stripe billing ────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# Get webhook secret from https://dashboard.stripe.com/webhooks

# Secret key (sk_live_... for production, sk_test_... for testing)
STRIPE_SECRET_KEY=

# Three-tier pricing — create three products in Stripe Dashboard.
# Tier hierarchy: wrapleads (1) < shopflow (2) < wrapos (3).
#   WrapLeads  → Products → "WrapLeads"  → $79/mo  recurring → copy price_xxx
#   ShopFlow   → Products → "ShopFlow"   → $149/mo recurring → copy price_xxx
#   WrapOS     → Products → "WrapOS"     → $249/mo recurring → copy price_xxx
STRIPE_PRICE_ID_WRAPLEADS=
STRIPE_PRICE_ID_SHOPFLOW=
STRIPE_PRICE_ID_WRAPOS=

# Legacy single-tier fallback (still works if the above are not set)
STRIPE_PRICE_ID=

# Webhook signing secret
# For local testing: stripe listen --forward-to localhost:3001/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Set to "true" to bypass ALL subscription/tier gating. Use for local dev
# without Stripe — every account gets full WrapOS access.
STRIPE_DISABLED=

# URL users land on after successful Stripe Checkout (used by lib/email.js).
# In production: your real domain. For local dev: http://localhost:3001
APP_URL=http://localhost:3001

# Public base URL for email-tracking pixels, portal links, and quote-form
# links (used by the server). MUST be set to the public domain in production
# or these links point at localhost. Falls back to APP_URL if unset.
APP_BASE_URL=

# ── AI Email Generation ───────────────────────────────────────────────────────
# Anthropic API key — powers AI email generation for all users (no per-user key needed)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Free tier: 3,000 emails/month. Sign up at resend.com
# If not set, email sending is silently skipped (safe for local dev)
RESEND_API_KEY=
# Verified sender address. Must be from a domain you own and have verified in Resend.
RESEND_FROM=WrapLeads <noreply@wrapleads.io>

# ── Public Demo Access ────────────────────────────────────────────────────────
# Set to the email of a pre-seeded demo account. When set, the public landing
# page shows a "Try the demo" button that mints a 24h JWT for this user.
# Investors/partners can poke around without registering. Leave blank to hide.
DEMO_USER_EMAIL=

# ── E Ink Device Provisioning ─────────────────────────────────────────────────
# REQUIRED in production. Any device that POSTs this value to /devices/register
# can self-register against any user_id, so treat it like a secret.
# In dev (NODE_ENV != 'production') it falls back to "eink-dev-secret".
EINK_PROVISION_SECRET=
