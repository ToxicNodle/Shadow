# Copy this to `.env` and fill in your values. The .env file is gitignored.

# ── Runtime environment ───────────────────────────────────────────────────────
# Set to "production" on Railway/Heroku/Render. Controls EINK secret fallback,
# error verbosity, and future NODE_ENV-gated behaviour.
NODE_ENV=development

# Postgres connection — defaults match docker-compose.yml
DATABASE_URL=postgresql://wrapleads:wrapleads@localhost:5432/wrapleads

# Server port
PORT=3001

# ── Auth (required for SaaS mode) ────────────────────────────────────────────
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Trial length for new accounts (days). Default: 14
TRIAL_DAYS=14

# ── Stripe billing ────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# Get webhook secret from https://dashboard.stripe.com/webhooks

STRIPE_SECRET_KEY=

# Three-tier pricing — create three products in Stripe Dashboard.
# Tier hierarchy: wrapleads (1) < shopflow (2) < wrapos (3)
#   WrapLeads  → $79/mo  recurring → copy price_xxx here
#   ShopFlow   → $149/mo recurring → copy price_xxx here
#   WrapOS     → $249/mo recurring → copy price_xxx here
STRIPE_PRICE_ID_WRAPLEADS=
STRIPE_PRICE_ID_SHOPFLOW=
STRIPE_PRICE_ID_WRAPOS=

# Legacy single-tier fallback (still works as the WrapLeads tier if the above are not set)
STRIPE_PRICE_ID=

# Webhook signing secret
# For local testing: stripe listen --forward-to localhost:3001/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Payments are DISABLED by default — all accounts get full WrapOS access for free.
# Set to "false" (and configure Stripe keys above) when you're ready to charge.
STRIPE_DISABLED=true

# ── App URLs ──────────────────────────────────────────────────────────────────
# Base URL for OAuth redirects and Stripe success/cancel redirects.
# In production: your real domain (https://app.wrapleads.io)
APP_URL=http://localhost:3001

# Public base URL for email-tracking pixels, portal links, and quote-form links.
# Must be set to the public domain in production or these links point at localhost.
# Falls back to APP_URL if unset.
APP_BASE_URL=

# ── AI / Anthropic ────────────────────────────────────────────────────────────
# Powers AI email generation, proposals, call scripts, and Vision features.
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Free tier: 3,000 emails/month. Sign up at resend.com
# If not set, email sending is silently skipped (safe for local dev).
RESEND_API_KEY=
# Verified sender address for outreach emails (AI sequences, broadcasts, proposals).
# Must be from a domain you own and have verified in Resend.
# Defaults to outreach@wrapleads.io if unset.
RESEND_FROM_EMAIL=outreach@wrapleads.io

# ── Apollo.io contact enrichment ─────────────────────────────────────────────
# If set here, the server uses it for all users. If blank, each user supplies
# their own key via Settings → Integrations (stored in settings_json).
APOLLO_API_KEY=

# Hunter.io — free tier: 25 domain searches + 50 email verifications/month.
# Used as a pre-Apollo waterfall in /apollo/enrich. Optional — Apollo is used
# as fallback when Hunter doesn't find a confident match (score < 60).
HUNTER_API_KEY=

# ── Google Places (ingest only) ───────────────────────────────────────────────
# Only needed when running scripts/ingest-google-places.js.
# Not used by the server at runtime.
GOOGLE_PLACES_API_KEY=

# ── SAM.gov federal contractor ingest ────────────────────────────────────────
# Free API key unlocks higher rate limits and more data fields.
# Get one at: https://sam.gov/profile/details
# Without a key the script uses DEMO_KEY which is heavily rate-limited.
# Run: npm run ingest:sam [-- --naics 238,484,532,541] [-- --state TX]
SAM_API_KEY=

# ── Vapi AI phone calls ───────────────────────────────────────────────────────
# Add to the webhook URL registered in Vapi:
#   https://your-domain.com/calls/webhook?secret=<VAPI_WEBHOOK_SECRET>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# Public Demo Call widget (/demo) — use a SEPARATE Vapi account/key from the
# one your real customers use. This prevents demo abuse from burning your
# production phone number's reputation.
DEMO_VAPI_API_KEY=
DEMO_VAPI_PHONE_NUMBER_ID=

# ── E Ink Device Provisioning ─────────────────────────────────────────────────
# REQUIRED in production. Any device posting this secret to /devices/register
# can self-register, so treat it like a password.
# In dev (NODE_ENV != 'production') falls back to "eink-dev-secret".
EINK_PROVISION_SECRET=

# ── OpenWeatherMap (weather-triggered E-Ink content) ─────────────────────────
# Free tier: 1,000 calls/day. Get at: https://openweathermap.org/appid
# When set, the weather worker checks each shop's city daily at 7 AM and
# auto-triggers relevant content pushes to E-Ink fleet displays.
# Hot day (>85°F) → "Summer Wrap Special" push.
# Winter cold (<20°F) → "Interior Film / DI-NOC" push.
OPENWEATHER_API_KEY=

# ── Public Demo Access ────────────────────────────────────────────────────────
# Email of a pre-seeded demo account. When set, the landing page shows a
# "Try the demo" button that mints a 24h JWT for this user.
# Leave blank to hide the button.
DEMO_USER_EMAIL=

