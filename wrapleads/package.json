{
  "name": "wrapleads",
  "version": "0.3.0",
  "private": true,
  "description": "B2B lead-gen platform for vehicle wrap and graphics shops.",
  "scripts": {
    "start": "node wrapleads-server.js",
    "dev": "node --watch wrapleads-server.js",
    "ingest:fmcsa": "node ingest-fmcsa.js",
    "ingest:sos": "node ingest-sos.js",
    "ingest:places": "node ingest-google-places.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec db psql -U wrapleads -d wrapleads"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
