{
  "name": "wrapleads",
  "version": "0.4.0",
  "private": true,
  "description": "B2B lead-gen platform for vehicle wrap and graphics shops.",
  "scripts": {
    "start": "node wrapleads-server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "node --watch wrapleads-server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "ingest:fmcsa": "node ingest-fmcsa.js",
    "ingest:sos": "node ingest-sos.js",
    "ingest:places": "node ingest-google-places.js",
    "ingest:commercial": "node ingest-commercial-buildings.js",
    "seed:leads": "node scripts/seed-20k-leads.js",
    "test": "node --test 'test/**/*.test.js'",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec db psql -U wrapleads -d wrapleads",
    "demo:seed": "node lib/demoSeed.js"
  },
  "devDependencies": {
    "concurrently": "^8"
  },
  "dependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "puppeteer-core": "^23.11.1",
    "resend": "^4",
    "sharp": "^0.34.5",
    "stripe": "^16.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
