{
  "name": "wrapleads",
  "version": "0.4.0",
  "private": true,
  "description": "B2B lead-gen platform for vehicle wrap and graphics shops.",
  "scripts": {
    "start": "node wrapleads-server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "node --watch wrapleads-server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "ingest:fmcsa": "node ingest-fmcsa.js",
    "ingest:sos": "node ingest-sos.js",
    "ingest:places": "node ingest-google-places.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec db psql -U wrapleads -d wrapleads"
  },
  "devDependencies": {
    "concurrently": "^8"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "resend": "^4",
    "stripe": "^16.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
